# Upstash Redis (REST). No Vercel, estas duas variáveis são preenchidas
# automaticamente ao adicionar a integração "Upstash" pelo Marketplace.
# Para dev local você pode deixar VAZIO — o app cai num fallback em memória
# (os dados somem quando o servidor reinicia; aparece um aviso no console).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sponsored flights: Stripe Checkout + signed webhook.
# Production: https://nort.works (localhost is only for local development).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fixed one-time Price IDs (price_...). The legacy variable remains a 1-day fallback.
STRIPE_SPONSOR_PRICE_ID=
STRIPE_SPONSOR_PRICE_ID_1D=
STRIPE_SPONSOR_PRICE_ID_3D=
STRIPE_SPONSOR_PRICE_ID_10D=
SPONSOR_ADMIN_KEY=replace-with-at-least-32-random-characters
# Keep 0 until Stripe, webhook and moderation have been tested in production.
SPONSOR_SALES_ENABLED=0

# Local development only: fake a successful checkout when Stripe is absent.
SPONSOR_DEMO_MODE=0
